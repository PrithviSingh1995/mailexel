generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("POSTGRES_PRISMA_URL")
  directUrl = env("POSTGRES_URL_NON_POOLING")
}

model User {
  id            String     @id @default(cuid())
  name          String
  email         String     @unique
  password      String
  role          String     @default("editor")
  avatar        String     @default("")
  bio           String     @default("")
  createdAt     DateTime   @default(now())
  updatedAt     DateTime   @updatedAt
  blogs         Blog[]
  assignedTasks BlogTask[]
}

model PageContent {
  id        String   @id @default(cuid())
  slug      String   @unique
  content   Json
  updatedAt DateTime @updatedAt
}

model RatingVote {
  id        String   @id @default(cuid())
  rating    Int
  createdAt DateTime @default(now())
}

model Review {
  id          String   @id @default(cuid())
  authorName  String
  authorRole  String   @default("")
  authorImage String   @default("")
  rating      Int      @default(5)
  content     String
  tag         String   @default("")
  tagDark     Boolean  @default(false)
  published   Boolean  @default(false)
  showOnHome  Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model BlogTask {
  id               String   @id @default(cuid())
  title            String
  status           String   @default("pending")
  assignedAuthorId String?
  assignedAuthor   User?    @relation(fields: [assignedAuthorId], references: [id], onDelete: SetNull)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
}

model Blog {
  id              String    @id @default(cuid())
  title           String
  slug            String    @unique
  excerpt         String
  content         String
  featuredImage   String    @default("")
  authorId        String
  author          User      @relation(fields: [authorId], references: [id])
  category        String    @default("General")
  tags            String[]
  status          String    @default("draft")
  publishedAt     DateTime?
  views           Int       @default(0)
  metaTitle       String    @default("")
  metaDescription String    @default("")
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
}
